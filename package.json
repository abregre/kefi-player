{
  "name": "kefi-player",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "sync": "npm run build && npm run build:potoken && npx cap sync android",
    "apk": "bash scripts/build-apk.sh debug",
    "apk:release": "bash scripts/build-apk.sh release",
    "apk:roadsync": "bash scripts/build-apk.sh debug roadsync",
    "release:patch": "npm version patch --git-tag-version=true -m \"Kefi Player %s\"",
    "release:minor": "npm version minor --git-tag-version=true -m \"Kefi Player %s\"",
    "release:major": "npm version major --git-tag-version=true -m \"Kefi Player %s\"",
    "install:apk": "adb install -r android/app/build/outputs/apk/standard/debug/app-standard-debug.apk",
    "install:apk:roadsync": "adb install -r android/app/build/outputs/apk/roadsync/debug/app-roadsync-debug.apk",
    "open": "CAPACITOR_ANDROID_STUDIO_PATH=/snap/bin/android-studio npx cap open android",
    "dev:android": "npx cap run android --live-reload --external",
    "build:potoken": "vite build --config vite.potoken.config.ts",
    "icons": "python3 scripts/make-icons.py",
    "fonts": "python3 scripts/fetch-fonts.py",
    "keystore": "bash scripts/make-keystore.sh",
    "fixtures": "bash scripts/qa-fixtures.sh",
    "qa": "bash scripts/qa-playback.sh"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/preferences": "^8.0.1",
    "bgutils-js": "^4.0.3",
    "vue": "^3.5.40",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
