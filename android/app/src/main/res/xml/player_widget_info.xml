<?xml version="1.0" encoding="utf-8"?>
<!--
    updatePeriodMillis is 0 on purpose: the widget is pushed from PlayerController on every
    state change, so letting the system wake the app on a timer as well would cost battery
    to redraw something that has not moved.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:initialLayout="@layout/player_widget"
    android:minWidth="272dp"
    android:minHeight="48dp"
    android:targetCellWidth="4"
    android:targetCellHeight="1"
    android:minResizeWidth="180dp"
    android:minResizeHeight="48dp"
    android:resizeMode="horizontal"
    android:updatePeriodMillis="0"
    android:description="@string/widget_description"
    android:previewLayout="@layout/player_widget"
    android:widgetCategory="home_screen" />
