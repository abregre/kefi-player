<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>


    <!--
        The launch theme, and the only place the splash is configured. Two eras have to be
        served at once:
          - Android 11 and below take the whole window background as the splash, which is
            what the generated drawable*/splash.png bitmaps are for.
          - Android 12+ IGNORE that bitmap completely and compose the splash themselves from
            the two windowSplashScreen* attributes below. Without them the platform falls
            back to the launcher icon on the theme's own window background, which is how this
            app shipped its first build — right icon, wrong background, no control over either.
        The icon asset is drawable-nodpi/splash_icon.png (288dp canvas, artwork in the inner
        192dp) and both it and the colour are regenerated by `npm run icons`.
        No postSplashScreenTheme is needed: Capacitor's BridgeActivity calls
        setTheme(AppTheme_NoActionBar) itself in onCreate.
    -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
    </style>
</resources>